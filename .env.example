# Readify AI — Environment Configuration

# Application Context
PROJECT_NAME="Readify AI"
JWT_SECRET="generate_a_long_random_hex_string_for_production"

# Database Configuration
# Default local PostgreSQL connection details
DATABASE_URL="postgresql://postgres:kjbb2320@localhost:5432/readify"
DATABASE_URL_MASTER="postgresql://postgres:kjbb2320@localhost:5432/postgres"

# Redis Queue (Optional for Celery/Docker)
REDIS_URL="redis://localhost:6379/0"

# Storage Settings (local or s3)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="readify-audiobooks"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Text-to-Speech Settings (edge, openai, elevenlabs)
# - edge: Free neural voices (no API key required)
# - openai: OpenAI Audio TTS API (requires OPENAI_API_KEY)
# - elevenlabs: ElevenLabs API (requires ELEVENLABS_API_KEY)
TTS_PROVIDER="edge"
OPENAI_API_KEY="your_openai_api_key_here"
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# Google Gemini API Key (Required for AI assistant & RAG summaries)
GEMINI_API_KEY="your_gemini_api_key_here"
